LEDGERAI_ENVIRONMENT=development
LEDGERAI_API_HOST=127.0.0.1
LEDGERAI_API_PORT=8000
LEDGERAI_DATABASE_DSN=postgresql+psycopg://ledgerai_runtime:local-runtime-only@127.0.0.1:5432/ledgerai
LEDGERAI_MIGRATION_DSN=postgresql+psycopg://ledgerai_migrator:local-migration-only@127.0.0.1:5432/ledgerai
LEDGERAI_ALLOWED_HOSTS=["localhost","127.0.0.1"]
LEDGERAI_CORS_ORIGINS=[]
LEDGERAI_JWT_ISSUER=https://identity.example.invalid/
LEDGERAI_JWT_AUDIENCE=ledgerai-api
LEDGERAI_JWT_ALGORITHMS=["RS256"]
LEDGERAI_JWKS_URL=https://identity.example.invalid/.well-known/jwks.json
LEDGERAI_LOG_LEVEL=INFO
LEDGERAI_SERVICE_NAME=ledgerai-backend
LEDGERAI_SERVICE_VERSION=1.2.0
LEDGERAI_STORAGE_ENDPOINT_URL=http://127.0.0.1:9000
LEDGERAI_STORAGE_REGION=us-east-1
LEDGERAI_STORAGE_BUCKET=ledgerai-evidence
LEDGERAI_STORAGE_ACCESS_KEY=ledgerai-minio-local
LEDGERAI_STORAGE_SECRET_KEY=local-storage-only-change-me
LEDGERAI_STORAGE_USE_TLS=false
LEDGERAI_STORAGE_PRESIGN_SECONDS=300
LEDGERAI_STORAGE_MAX_UPLOAD_BYTES=10485760
LEDGERAI_SCANNER_ADAPTER=deterministic
LEDGERAI_SCANNER_TIMEOUT_SECONDS=30
LEDGERAI_REDIS_URL=redis://127.0.0.1:6379/0
LEDGERAI_QUEUE_DEFAULT=ledgerai.workflow
LEDGERAI_QUEUE_MAX_ATTEMPTS=5
LEDGERAI_CSV_MAX_ROWS=10000
LEDGERAI_CSV_MAX_COLUMNS=32
LEDGERAI_CSV_MAX_CELL_CHARS=4096
LEDGERAI_IDEMPOTENCY_TTL_SECONDS=86400
