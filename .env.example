LEDGERAI_ENVIRONMENT=development
LEDGERAI_API_HOST=127.0.0.1
LEDGERAI_API_PORT=8000
LEDGERAI_DATABASE_DSN=postgresql+psycopg://ledgerai_runtime:local-runtime-only@127.0.0.1:5432/ledgerai
LEDGERAI_MIGRATION_DSN=postgresql+psycopg://ledgerai_migrator:local-migration-only@127.0.0.1:5432/ledgerai
LEDGERAI_ALLOWED_HOSTS=["localhost","127.0.0.1"]
LEDGERAI_CORS_ORIGINS=[]
LEDGERAI_JWT_ISSUER=https://identity.example.invalid/
LEDGERAI_JWT_AUDIENCE=ledgerai-api
LEDGERAI_JWT_ALGORITHMS=["RS256"]
LEDGERAI_JWKS_URL=https://identity.example.invalid/.well-known/jwks.json
LEDGERAI_LOG_LEVEL=INFO
LEDGERAI_SERVICE_NAME=ledgerai-backend
LEDGERAI_SERVICE_VERSION=1.1.0
