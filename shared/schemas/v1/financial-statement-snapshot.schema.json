{
  "$defs": {
    "CorrelationMetadata": {
      "additionalProperties": false,
      "description": "Request starts an interaction; correlation spans it; causation identifies its parent.",
      "properties": {
        "causation_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Causation Id"
        },
        "correlation_id": {
          "format": "uuid",
          "title": "Correlation Id",
          "type": "string"
        },
        "request_id": {
          "format": "uuid",
          "title": "Request Id",
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "correlation_id"
      ],
      "title": "CorrelationMetadata",
      "type": "object"
    },
    "EntityTenantContext": {
      "additionalProperties": false,
      "properties": {
        "legal_entity_id": {
          "format": "uuid",
          "title": "Legal Entity Id",
          "type": "string"
        },
        "organization_id": {
          "format": "uuid",
          "title": "Organization Id",
          "type": "string"
        },
        "tenant_id": {
          "format": "uuid",
          "title": "Tenant Id",
          "type": "string"
        }
      },
      "required": [
        "tenant_id",
        "organization_id",
        "legal_entity_id"
      ],
      "title": "EntityTenantContext",
      "type": "object"
    },
    "FinancialStatementLine": {
      "additionalProperties": false,
      "properties": {
        "account_reference": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Account Reference",
          "type": "string"
        },
        "amount": {
          "$ref": "#/$defs/Money"
        },
        "label": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "ledger_references": {
          "items": {
            "$ref": "#/$defs/ResourceReference"
          },
          "maxItems": 200,
          "title": "Ledger References",
          "type": "array"
        },
        "line_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Line Id",
          "type": "string"
        }
      },
      "required": [
        "line_id",
        "account_reference",
        "label",
        "amount"
      ],
      "title": "FinancialStatementLine",
      "type": "object"
    },
    "Money": {
      "additionalProperties": false,
      "description": "Exact money. JSON amount is always a decimal string; floats are forbidden.",
      "properties": {
        "amount": {
          "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
          "title": "Amount",
          "type": "string"
        },
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "title": "Money",
      "type": "object"
    },
    "ProducerMetadata": {
      "additionalProperties": false,
      "properties": {
        "algorithm_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Algorithm Version"
        },
        "model_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Name"
        },
        "model_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Version"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "producer_type": {
          "$ref": "#/$defs/ProducerType"
        },
        "prompt_template_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Template Version"
        },
        "rule_or_policy_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rule Or Policy Version"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "producer_type",
        "name",
        "version"
      ],
      "title": "ProducerMetadata",
      "type": "object"
    },
    "ProducerType": {
      "enum": [
        "SERVICE",
        "AGENT",
        "MODEL",
        "RULE_ENGINE",
        "HUMAN"
      ],
      "title": "ProducerType",
      "type": "string"
    },
    "ResourceReference": {
      "additionalProperties": false,
      "properties": {
        "resource_id": {
          "format": "uuid",
          "title": "Resource Id",
          "type": "string"
        },
        "resource_type": {
          "minLength": 1,
          "title": "Resource Type",
          "type": "string"
        },
        "resource_version": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resource Version"
        }
      },
      "required": [
        "resource_type",
        "resource_id"
      ],
      "title": "ResourceReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "accounting_period_id": {
      "format": "uuid",
      "title": "Accounting Period Id",
      "type": "string"
    },
    "as_of": {
      "format": "date-time",
      "title": "As Of",
      "type": "string"
    },
    "correlation": {
      "$ref": "#/$defs/CorrelationMetadata"
    },
    "currency": {
      "pattern": "^[A-Z]{3}$",
      "title": "Currency",
      "type": "string"
    },
    "lines": {
      "items": {
        "$ref": "#/$defs/FinancialStatementLine"
      },
      "maxItems": 10000,
      "title": "Lines",
      "type": "array"
    },
    "producer": {
      "$ref": "#/$defs/ProducerMetadata"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "snapshot_id": {
      "format": "uuid",
      "title": "Snapshot Id",
      "type": "string"
    },
    "statement_type": {
      "enum": [
        "TRIAL_BALANCE",
        "PROFIT_AND_LOSS",
        "BALANCE_SHEET"
      ],
      "title": "Statement Type",
      "type": "string"
    },
    "status": {
      "enum": [
        "AVAILABLE",
        "IN_PROGRESS",
        "UNAVAILABLE",
        "FAILED"
      ],
      "title": "Status",
      "type": "string"
    },
    "tenant_context": {
      "$ref": "#/$defs/EntityTenantContext"
    }
  },
  "required": [
    "schema_version",
    "snapshot_id",
    "tenant_context",
    "accounting_period_id",
    "statement_type",
    "currency",
    "as_of",
    "status",
    "producer",
    "correlation"
  ],
  "title": "FinancialStatementSnapshot",
  "type": "object"
}
