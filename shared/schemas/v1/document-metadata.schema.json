{
  "$defs": {
    "ActorReference": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "minLength": 1,
          "title": "Actor Id",
          "type": "string"
        },
        "actor_type": {
          "enum": [
            "HUMAN",
            "SERVICE",
            "AGENT"
          ],
          "title": "Actor Type",
          "type": "string"
        }
      },
      "required": [
        "actor_type",
        "actor_id"
      ],
      "title": "ActorReference",
      "type": "object"
    },
    "CorrelationMetadata": {
      "additionalProperties": false,
      "description": "Request starts an interaction; correlation spans it; causation identifies its parent.",
      "properties": {
        "causation_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Causation Id"
        },
        "correlation_id": {
          "format": "uuid",
          "title": "Correlation Id",
          "type": "string"
        },
        "request_id": {
          "format": "uuid",
          "title": "Request Id",
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "correlation_id"
      ],
      "title": "CorrelationMetadata",
      "type": "object"
    },
    "DocumentLifecycle": {
      "enum": [
        "UPLOADED",
        "PROCESSING",
        "READY",
        "QUARANTINED",
        "FAILED"
      ],
      "title": "DocumentLifecycle",
      "type": "string"
    },
    "EntityTenantContext": {
      "additionalProperties": false,
      "properties": {
        "legal_entity_id": {
          "format": "uuid",
          "title": "Legal Entity Id",
          "type": "string"
        },
        "organization_id": {
          "format": "uuid",
          "title": "Organization Id",
          "type": "string"
        },
        "tenant_id": {
          "format": "uuid",
          "title": "Tenant Id",
          "type": "string"
        }
      },
      "required": [
        "tenant_id",
        "organization_id",
        "legal_entity_id"
      ],
      "title": "EntityTenantContext",
      "type": "object"
    },
    "StorageReference": {
      "additionalProperties": false,
      "description": "Opaque immutable locator; never an OS path or credential-bearing URL.",
      "properties": {
        "object_key": {
          "minLength": 1,
          "title": "Object Key",
          "type": "string"
        },
        "storage_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Storage Version"
        }
      },
      "required": [
        "object_key"
      ],
      "title": "StorageReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "byte_size": {
      "minimum": 0,
      "title": "Byte Size",
      "type": "integer"
    },
    "content_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Content Hash",
      "type": "string"
    },
    "correlation": {
      "$ref": "#/$defs/CorrelationMetadata"
    },
    "detected_media_type": {
      "pattern": "^[\\w.+-]+/[\\w.+-]+$",
      "title": "Detected Media Type",
      "type": "string"
    },
    "document_category": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Document Category"
    },
    "document_id": {
      "format": "uuid",
      "title": "Document Id",
      "type": "string"
    },
    "hash_algorithm": {
      "const": "SHA-256",
      "default": "SHA-256",
      "title": "Hash Algorithm",
      "type": "string"
    },
    "lifecycle_status": {
      "$ref": "#/$defs/DocumentLifecycle"
    },
    "original_filename": {
      "description": "Untrusted display metadata",
      "minLength": 1,
      "title": "Original Filename",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "storage": {
      "$ref": "#/$defs/StorageReference"
    },
    "tenant_context": {
      "$ref": "#/$defs/EntityTenantContext"
    },
    "upload_actor": {
      "$ref": "#/$defs/ActorReference"
    },
    "uploaded_at": {
      "format": "date-time",
      "title": "Uploaded At",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "document_id",
    "tenant_context",
    "storage",
    "original_filename",
    "detected_media_type",
    "byte_size",
    "content_hash",
    "upload_actor",
    "uploaded_at",
    "lifecycle_status",
    "correlation"
  ],
  "title": "DocumentMetadata",
  "type": "object"
}
