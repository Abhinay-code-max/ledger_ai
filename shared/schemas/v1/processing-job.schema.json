{
  "$defs": {
    "CorrelationMetadata": {
      "additionalProperties": false,
      "description": "Request starts an interaction; correlation spans it; causation identifies its parent.",
      "properties": {
        "causation_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Causation Id"
        },
        "correlation_id": {
          "format": "uuid",
          "title": "Correlation Id",
          "type": "string"
        },
        "request_id": {
          "format": "uuid",
          "title": "Request Id",
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "correlation_id"
      ],
      "title": "CorrelationMetadata",
      "type": "object"
    },
    "EntityTenantContext": {
      "additionalProperties": false,
      "properties": {
        "legal_entity_id": {
          "format": "uuid",
          "title": "Legal Entity Id",
          "type": "string"
        },
        "organization_id": {
          "format": "uuid",
          "title": "Organization Id",
          "type": "string"
        },
        "tenant_id": {
          "format": "uuid",
          "title": "Tenant Id",
          "type": "string"
        }
      },
      "required": [
        "tenant_id",
        "organization_id",
        "legal_entity_id"
      ],
      "title": "EntityTenantContext",
      "type": "object"
    },
    "ResourceReference": {
      "additionalProperties": false,
      "properties": {
        "resource_id": {
          "format": "uuid",
          "title": "Resource Id",
          "type": "string"
        },
        "resource_type": {
          "minLength": 1,
          "title": "Resource Type",
          "type": "string"
        },
        "resource_version": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resource Version"
        }
      },
      "required": [
        "resource_type",
        "resource_id"
      ],
      "title": "ResourceReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "QUEUED"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "completed_at": {
            "type": "null"
          },
          "error_code": {
            "type": "null"
          },
          "failed_at": {
            "type": "null"
          },
          "retry_at": {
            "type": "null"
          },
          "safe_error_message": {
            "type": "null"
          },
          "started_at": {
            "type": "null"
          }
        },
        "required": []
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "PROCESSING"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "completed_at": {
            "type": "null"
          },
          "error_code": {
            "type": "null"
          },
          "failed_at": {
            "type": "null"
          },
          "retry_at": {
            "type": "null"
          },
          "safe_error_message": {
            "type": "null"
          },
          "started_at": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "started_at"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "RETRY_SCHEDULED"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "completed_at": {
            "type": "null"
          },
          "error_code": {
            "minLength": 1,
            "type": "string"
          },
          "failed_at": {
            "format": "date-time",
            "type": "string"
          },
          "retry_at": {
            "format": "date-time",
            "type": "string"
          },
          "retryable": {
            "const": true
          },
          "safe_error_message": {
            "minLength": 1,
            "type": "string"
          },
          "started_at": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "started_at",
          "failed_at",
          "retry_at",
          "retryable",
          "error_code",
          "safe_error_message"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "REVIEW_REQUIRED"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "completed_at": {
            "type": "null"
          },
          "failed_at": {
            "type": "null"
          },
          "retry_at": {
            "type": "null"
          },
          "started_at": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "started_at"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "COMPLETED"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "completed_at": {
            "format": "date-time",
            "type": "string"
          },
          "error_code": {
            "type": "null"
          },
          "failed_at": {
            "type": "null"
          },
          "retry_at": {
            "type": "null"
          },
          "safe_error_message": {
            "type": "null"
          },
          "started_at": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "started_at",
          "completed_at"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "FAILED"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "completed_at": {
            "type": "null"
          },
          "error_code": {
            "minLength": 1,
            "type": "string"
          },
          "failed_at": {
            "format": "date-time",
            "type": "string"
          },
          "retry_at": {
            "type": "null"
          },
          "safe_error_message": {
            "minLength": 1,
            "type": "string"
          },
          "started_at": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "started_at",
          "failed_at",
          "error_code",
          "safe_error_message"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "DEAD_LETTERED"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "completed_at": {
            "type": "null"
          },
          "error_code": {
            "minLength": 1,
            "type": "string"
          },
          "failed_at": {
            "format": "date-time",
            "type": "string"
          },
          "retry_at": {
            "type": "null"
          },
          "retryable": {
            "const": false
          },
          "safe_error_message": {
            "minLength": 1,
            "type": "string"
          },
          "started_at": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "started_at",
          "failed_at",
          "retryable",
          "error_code",
          "safe_error_message"
        ]
      }
    }
  ],
  "properties": {
    "attempt_number": {
      "minimum": 0,
      "title": "Attempt Number",
      "type": "integer"
    },
    "completed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Completed At"
    },
    "correlation": {
      "$ref": "#/$defs/CorrelationMetadata"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "error_code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Code"
    },
    "failed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failed At"
    },
    "input_references": {
      "items": {
        "$ref": "#/$defs/ResourceReference"
      },
      "minItems": 1,
      "title": "Input References",
      "type": "array"
    },
    "job_id": {
      "format": "uuid",
      "title": "Job Id",
      "type": "string"
    },
    "job_type": {
      "minLength": 1,
      "title": "Job Type",
      "type": "string"
    },
    "maximum_attempts": {
      "minimum": 1,
      "title": "Maximum Attempts",
      "type": "integer"
    },
    "output_references": {
      "items": {
        "$ref": "#/$defs/ResourceReference"
      },
      "title": "Output References",
      "type": "array"
    },
    "progress_percent": {
      "anyOf": [
        {
          "maximum": 100,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Progress Percent"
    },
    "queue_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Queue Name"
    },
    "retry_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Retry At"
    },
    "retryable": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Retryable"
    },
    "safe_error_message": {
      "anyOf": [
        {
          "description": "User-safe text only; runtime middleware must still sanitize exceptions.",
          "maxLength": 1000,
          "minLength": 1,
          "pattern": "^(?![\\s\\S]*(?:Traceback \\(most recent call last\\)|BEGIN (?:RSA )?PRIVATE KEY|(?:postgres(?:ql)?|mysql|mongodb|redis|jdbc):\\/\\/|Bearer eyJ|ghp_|sk_live_|AKIA|[A-Za-z]:\\\\|\\/(?:etc|var|home|Users|root|tmp)\\/|(?:\\b[Ss][Ee][Ll][Ee][Cc][Tt]\\s+(?:\\*|[A-Za-z_][A-Za-z0-9_]*\\s*,\\s*[A-Za-z_][A-Za-z0-9_]*(?:\\s*,\\s*[A-Za-z_][A-Za-z0-9_]*)*|[A-Za-z][A-Za-z0-9]*_[A-Za-z0-9_]+)\\s+[Ff][Rr][Oo][Mm]\\s+[A-Za-z_][A-Za-z0-9_]*\\b|\\b[Ss][Ee][Ll][Ee][Cc][Tt]\\s+[A-Za-z_][A-Za-z0-9_]*\\s+[Ff][Rr][Oo][Mm]\\s+[A-Za-z_][A-Za-z0-9_]*\\s*(?:;|$)|\\b[Ss][Ee][Ll][Ee][Cc][Tt]\\s+[A-Za-z_][A-Za-z0-9_]*\\s+[Ff][Rr][Oo][Mm]\\s+[A-Za-z_][A-Za-z0-9_]*\\s+(?:[Ww][Hh][Ee][Rr][Ee]|[Jj][Oo][Ii][Nn]|[Ll][Ii][Mm][Ii][Tt]|[Oo][Rr][Dd][Ee][Rr]\\s+[Bb][Yy]|[Gg][Rr][Oo][Uu][Pp]\\s+[Bb][Yy])\\b|\\b[Ii][Nn][Ss][Ee][Rr][Tt]\\s+[Ii][Nn][Tt][Oo]\\s+[A-Za-z_][A-Za-z0-9_]*\\s*(?:\\(|[Vv][Aa][Ll][Uu][Ee][Ss]\\b|[Ss][Ee][Ll][Ee][Cc][Tt]\\b)|\\b[Uu][Pp][Dd][Aa][Tt][Ee]\\s+[A-Za-z_][A-Za-z0-9_]*\\s+[Ss][Ee][Tt]\\s+[A-Za-z_][A-Za-z0-9_]*\\s*=|\\b[Dd][Ee][Ll][Ee][Tt][Ee]\\s+[Ff][Rr][Oo][Mm]\\s+[A-Za-z_][A-Za-z0-9_]*\\s*(?:;|$|[Ww][Hh][Ee][Rr][Ee]\\b)|\\b(?:[Dd][Rr][Oo][Pp]|[Aa][Ll][Tt][Ee][Rr]|[Tt][Rr][Uu][Nn][Cc][Aa][Tt][Ee]|[Cc][Rr][Ee][Aa][Tt][Ee])\\s+[Tt][Aa][Bb][Ll][Ee]\\s+[A-Za-z_][A-Za-z0-9_]*\\b)))[\\s\\S]{1,1000}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Safe Error Message"
    },
    "scheduled_for": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Scheduled For"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "started_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Started At"
    },
    "state": {
      "enum": [
        "QUEUED",
        "PROCESSING",
        "RETRY_SCHEDULED",
        "REVIEW_REQUIRED",
        "COMPLETED",
        "FAILED",
        "DEAD_LETTERED"
      ],
      "title": "State",
      "type": "string"
    },
    "tenant_context": {
      "$ref": "#/$defs/EntityTenantContext"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "job_id",
    "tenant_context",
    "job_type",
    "state",
    "attempt_number",
    "maximum_attempts",
    "input_references",
    "correlation",
    "created_at",
    "updated_at"
  ],
  "title": "ProcessingJob",
  "type": "object",
  "x-ledgerai-pydantic-invariants": [
    "attempt_number must not exceed maximum_attempts",
    "DEAD_LETTERED requires attempt_number equal to maximum_attempts",
    "timestamps must follow created/start/update/failure/completion ordering",
    "retry_at must be later than the failed or updated attempt"
  ]
}
