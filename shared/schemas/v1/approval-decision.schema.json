{
  "$defs": {
    "ActorReference": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "minLength": 1,
          "title": "Actor Id",
          "type": "string"
        },
        "actor_type": {
          "enum": [
            "HUMAN",
            "SERVICE",
            "AGENT"
          ],
          "title": "Actor Type",
          "type": "string"
        }
      },
      "required": [
        "actor_type",
        "actor_id"
      ],
      "title": "ActorReference",
      "type": "object"
    },
    "CorrelationMetadata": {
      "additionalProperties": false,
      "description": "Request starts an interaction; correlation spans it; causation identifies its parent.",
      "properties": {
        "causation_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Causation Id"
        },
        "correlation_id": {
          "format": "uuid",
          "title": "Correlation Id",
          "type": "string"
        },
        "request_id": {
          "format": "uuid",
          "title": "Request Id",
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "correlation_id"
      ],
      "title": "CorrelationMetadata",
      "type": "object"
    },
    "EntityTenantContext": {
      "additionalProperties": false,
      "properties": {
        "legal_entity_id": {
          "format": "uuid",
          "title": "Legal Entity Id",
          "type": "string"
        },
        "organization_id": {
          "format": "uuid",
          "title": "Organization Id",
          "type": "string"
        },
        "tenant_id": {
          "format": "uuid",
          "title": "Tenant Id",
          "type": "string"
        }
      },
      "required": [
        "tenant_id",
        "organization_id",
        "legal_entity_id"
      ],
      "title": "EntityTenantContext",
      "type": "object"
    },
    "VersionedResourceReference": {
      "additionalProperties": false,
      "description": "Reference bound to an exact immutable resource version.",
      "properties": {
        "resource_id": {
          "format": "uuid",
          "title": "Resource Id",
          "type": "string"
        },
        "resource_type": {
          "minLength": 1,
          "title": "Resource Type",
          "type": "string"
        },
        "resource_version": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
          "title": "Resource Version",
          "type": "string"
        }
      },
      "required": [
        "resource_type",
        "resource_id",
        "resource_version"
      ],
      "title": "VersionedResourceReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "action": {
      "enum": [
        "APPROVE",
        "CORRECT",
        "REJECT",
        "REQUEST_EVIDENCE",
        "ESCALATE"
      ],
      "title": "Action",
      "type": "string"
    },
    "actor": {
      "$ref": "#/$defs/ActorReference"
    },
    "approval_request_id": {
      "format": "uuid",
      "title": "Approval Request Id",
      "type": "string"
    },
    "authorization_roles": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Authorization Roles",
      "type": "array"
    },
    "correlation": {
      "$ref": "#/$defs/CorrelationMetadata"
    },
    "decided_at": {
      "format": "date-time",
      "title": "Decided At",
      "type": "string"
    },
    "decision_id": {
      "format": "uuid",
      "title": "Decision Id",
      "type": "string"
    },
    "reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason"
    },
    "reviewed_resource": {
      "$ref": "#/$defs/VersionedResourceReference"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "separation_of_duties_checked": {
      "title": "Separation Of Duties Checked",
      "type": "boolean"
    },
    "separation_of_duties_rule": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Separation Of Duties Rule"
    },
    "structured_corrections": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Structured Corrections"
    },
    "tenant_context": {
      "$ref": "#/$defs/EntityTenantContext"
    }
  },
  "required": [
    "schema_version",
    "decision_id",
    "tenant_context",
    "approval_request_id",
    "reviewed_resource",
    "actor",
    "action",
    "authorization_roles",
    "separation_of_duties_checked",
    "decided_at",
    "correlation"
  ],
  "title": "ApprovalDecision",
  "type": "object"
}
