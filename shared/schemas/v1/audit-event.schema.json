{
  "$defs": {
    "ActorReference": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "minLength": 1,
          "title": "Actor Id",
          "type": "string"
        },
        "actor_type": {
          "enum": [
            "HUMAN",
            "SERVICE",
            "AGENT"
          ],
          "title": "Actor Type",
          "type": "string"
        }
      },
      "required": [
        "actor_type",
        "actor_id"
      ],
      "title": "ActorReference",
      "type": "object"
    },
    "CorrelationMetadata": {
      "additionalProperties": false,
      "description": "Request starts an interaction; correlation spans it; causation identifies its parent.",
      "properties": {
        "causation_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Causation Id"
        },
        "correlation_id": {
          "format": "uuid",
          "title": "Correlation Id",
          "type": "string"
        },
        "request_id": {
          "format": "uuid",
          "title": "Request Id",
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "correlation_id"
      ],
      "title": "CorrelationMetadata",
      "type": "object"
    },
    "EntityTenantContext": {
      "additionalProperties": false,
      "properties": {
        "legal_entity_id": {
          "format": "uuid",
          "title": "Legal Entity Id",
          "type": "string"
        },
        "organization_id": {
          "format": "uuid",
          "title": "Organization Id",
          "type": "string"
        },
        "tenant_id": {
          "format": "uuid",
          "title": "Tenant Id",
          "type": "string"
        }
      },
      "required": [
        "tenant_id",
        "organization_id",
        "legal_entity_id"
      ],
      "title": "EntityTenantContext",
      "type": "object"
    },
    "ProducerMetadata": {
      "additionalProperties": false,
      "properties": {
        "algorithm_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Algorithm Version"
        },
        "model_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Name"
        },
        "model_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Version"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "producer_type": {
          "$ref": "#/$defs/ProducerType"
        },
        "prompt_template_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Template Version"
        },
        "rule_or_policy_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rule Or Policy Version"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "producer_type",
        "name",
        "version"
      ],
      "title": "ProducerMetadata",
      "type": "object"
    },
    "ProducerType": {
      "enum": [
        "SERVICE",
        "AGENT",
        "MODEL",
        "RULE_ENGINE",
        "HUMAN"
      ],
      "title": "ProducerType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "action": {
      "title": "Action",
      "type": "string"
    },
    "actor": {
      "$ref": "#/$defs/ActorReference"
    },
    "after_hash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "After Hash"
    },
    "audit_event_id": {
      "format": "uuid",
      "title": "Audit Event Id",
      "type": "string"
    },
    "before_hash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Before Hash"
    },
    "client_metadata": {
      "anyOf": [
        {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Client Metadata"
    },
    "correlation": {
      "$ref": "#/$defs/CorrelationMetadata"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "outcome": {
      "enum": [
        "SUCCEEDED",
        "FAILED",
        "DENIED",
        "PENDING"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "policy_versions": {
      "items": {
        "type": "string"
      },
      "title": "Policy Versions",
      "type": "array"
    },
    "producer_versions": {
      "items": {
        "$ref": "#/$defs/ProducerMetadata"
      },
      "title": "Producer Versions",
      "type": "array"
    },
    "resource_id": {
      "format": "uuid",
      "title": "Resource Id",
      "type": "string"
    },
    "resource_type": {
      "title": "Resource Type",
      "type": "string"
    },
    "resource_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Resource Version"
    },
    "rule_versions": {
      "items": {
        "type": "string"
      },
      "title": "Rule Versions",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "schema_versions": {
      "items": {
        "type": "string"
      },
      "title": "Schema Versions",
      "type": "array"
    },
    "source_ip": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Ip"
    },
    "tenant_context": {
      "$ref": "#/$defs/EntityTenantContext"
    }
  },
  "required": [
    "schema_version",
    "audit_event_id",
    "tenant_context",
    "actor",
    "action",
    "resource_type",
    "resource_id",
    "correlation",
    "outcome",
    "occurred_at"
  ],
  "title": "AuditEvent",
  "type": "object"
}
