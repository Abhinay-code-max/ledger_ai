            "title": "Status",
            "type": "string"
          },
          "tenant_context": {
            "$ref": "#/components/schemas/EntityTenantContext"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "schema_version",
          "proposal_id",
          "proposal_version",
          "tenant_context",
          "records",
          "match_type",
          "confidence",
          "reasons",
          "producer",
          "status",
          "created_at",
          "updated_at",
          "correlation"
        ],
        "title": "MatchProposal",
        "type": "object"
      },
      "MatchReason": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "pattern": "^[A-Z][A-Z0-9_]+$",
            "title": "Code",
            "type": "string"
          },
          "contribution": {
            "anyOf": [
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
