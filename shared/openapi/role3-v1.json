{
  "components": {
    "schemas": {
      "BankTransaction": {
        "additionalProperties": false,
        "properties": {
          "bank_account_id": {
            "format": "uuid",
            "title": "Bank Account Id",
            "type": "string"
          },
          "booking_date": {
            "format": "date",
            "title": "Booking Date",
            "type": "string"
          },
          "content_fingerprint": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Content Fingerprint",
            "type": "string"
          },
          "correlation": {
            "$ref": "#/components/schemas/CorrelationMetadata"
          },
          "counterparty": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Counterparty"
              },
              {
                "type": "null"
              }
            ]
          },
          "direction": {
            "enum": [
              "DEBIT",
              "CREDIT"
            ],
            "title": "Direction",
            "type": "string"
          },
          "external_source_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "External Source Id"
          },
          "import_batch_id": {
            "format": "uuid",
            "title": "Import Batch Id",
            "type": "string"
          },
          "money": {
            "$ref": "#/components/schemas/PositiveMoney"
          },
          "narration": {
            "default": "",
            "title": "Narration",
            "type": "string"
          },
          "normalization_status": {
            "enum": [
              "NORMALIZED",
              "REVIEW_REQUIRED",
              "REJECTED"
            ],
            "title": "Normalization Status",
            "type": "string"
          },
          "provenance": {
            "items": {
              "$ref": "#/components/schemas/ProvenanceReference-Input"
            },
            "title": "Provenance",
            "type": "array"
          },
          "reference": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reference"
          },
          "schema_version": {
            "const": "1.0",
            "title": "Schema Version",
            "type": "string"
          },
          "source_row_number": {
            "minimum": 1.0,
            "title": "Source Row Number",
            "type": "integer"
          },
          "tenant_context": {
            "$ref": "#/components/schemas/EntityTenantContext"
          },
          "transaction_id": {
            "format": "uuid",
            "title": "Transaction Id",
            "type": "string"
          },
          "value_date": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value Date"
          }
        },
        "required": [
          "schema_version",
          "transaction_id",
          "tenant_context",
          "bank_account_id",
          "import_batch_id",
          "source_row_number",
          "booking_date",
          "money",
          "direction",
          "normalization_status",
          "provenance",
          "content_fingerprint",
          "correlation"
        ],
        "title": "BankTransaction",
        "type": "object"
      },
      "BoundingBox-Input": {
        "additionalProperties": false,
        "properties": {
          "height": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              }
            ],
            "title": "Height"
          },
          "page": {
            "minimum": 1.0,
            "title": "Page",
            "type": "integer"
          },
          "width": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              }
            ],
            "title": "Width"
          },
          "x": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              }
            ],
            "title": "X"
          },
          "y": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              }
            ],
            "title": "Y"
          }
        },
        "required": [
          "page",
          "x",
          "y",
          "width",
          "height"
        ],
        "title": "BoundingBox",
        "type": "object"
      },
      "BoundingBox-Output": {
        "additionalProperties": false,
        "properties": {
          "height": {
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Height",
            "type": "string"
          },
          "page": {
            "minimum": 1.0,
            "title": "Page",
            "type": "integer"
          },
          "width": {
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Width",
            "type": "string"
          },
          "x": {
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "X",
            "type": "string"
          },
          "y": {
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Y",
            "type": "string"
          }
        },
        "required": [
          "page",
          "x",
          "y",
          "width",
          "height"
        ],
        "title": "BoundingBox",
        "type": "object"
      },
      "CorrelationMetadata": {
        "additionalProperties": false,
