          },
          "reason_codes": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "title": "Reason Codes",
            "type": "array"
          },
          "required_action": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Required Action"
          },
          "resolution_reference": {
            "anyOf": [
