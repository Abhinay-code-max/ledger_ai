        "title": "MatchReason",
        "type": "object"
      },
      "Money": {
        "additionalProperties": false,
        "description": "Exact money. JSON amount is always a decimal string; floats are forbidden.",
        "properties": {
          "amount": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "title": "Amount",
            "type": "string"
          },
          "currency": {
            "pattern": "^[A-Z]{3}$",
            "title": "Currency",
            "type": "string"
          }
        },
        "required": [
          "amount",
          "currency"
        ],
        "title": "Money",
        "type": "object"
      },
      "PositiveMoney": {
        "additionalProperties": false,
        "description": "Exact positive money for records whose DEBIT/CREDIT field carries the sign.",
        "properties": {
          "amount": {
            "pattern": "^(?=.*[1-9])(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "title": "Amount",
            "type": "string"
          },
          "currency": {
            "pattern": "^[A-Z]{3}$",
            "title": "Currency",
            "type": "string"
          }
        },
        "required": [
          "amount",
          "currency"
