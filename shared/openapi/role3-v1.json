            "type": "string"
          },
          "match_type": {
            "enum": [
              "ONE_TO_ONE",
              "MANY_TO_ONE",
              "ONE_TO_MANY",
              "PARTIAL",
              "UNMATCHED"
            ],
            "title": "Match Type",
            "type": "string"
          },
          "producer": {
            "$ref": "#/components/schemas/ProducerMetadata"
          },
          "proposal_id": {
            "format": "uuid",
            "title": "Proposal Id",
            "type": "string"
          },
          "proposal_version": {
            "minimum": 1.0,
            "title": "Proposal Version",
            "type": "integer"
          },
          "provenance": {
            "items": {
              "$ref": "#/components/schemas/ProvenanceReference-Output"
            },
            "title": "Provenance",
            "type": "array"
          },
          "reasons": {
            "items": {
              "$ref": "#/components/schemas/MatchReason"
            },
            "minItems": 1,
            "title": "Reasons",
            "type": "array"
          },
          "records": {
            "items": {
              "$ref": "#/components/schemas/ResourceReference"
            },
            "minItems": 1,
            "title": "Records",
            "type": "array"
          },
          "schema_version": {
            "const": "1.0",
            "title": "Schema Version",
            "type": "string"
          },
          "score": {
            "anyOf": [
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              },
              {
                "type": "null"
