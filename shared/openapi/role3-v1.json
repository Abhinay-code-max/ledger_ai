      "InvoiceFact": {
        "additionalProperties": false,
        "description": "Role 1 facts reduced to the immutable evidence needed for matching.",
        "properties": {
          "amount": {
            "$ref": "#/components/schemas/Money"
          },
          "content_fingerprint": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Content Fingerprint",
            "type": "string"
          },
          "document_id": {
            "format": "uuid",
            "title": "Document Id",
            "type": "string"
          },
          "document_version": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
            "title": "Document Version",
            "type": "string"
          },
          "evidence_complete": {
            "title": "Evidence Complete",
            "type": "boolean"
          },
          "expected_transaction_direction": {
            "enum": [
              "DEBIT",
              "CREDIT"
            ],
            "title": "Expected Transaction Direction",
            "type": "string"
          },
          "extraction_id": {
            "format": "uuid",
            "title": "Extraction Id",
            "type": "string"
          },
          "extraction_version": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
            "title": "Extraction Version",
            "type": "string"
          },
          "invoice_date": {
            "format": "date",
            "title": "Invoice Date",
            "type": "string"
          },
          "party_name": {
            "anyOf": [
              {
                "maxLength": 256,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Party Name"
          },
          "provenance": {
            "items": {
              "$ref": "#/components/schemas/ProvenanceReference-Input"
            },
            "maxItems": 50,
            "title": "Provenance",
            "type": "array"
          },
          "reference": {
            "anyOf": [
              {
                "maxLength": 128,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reference"
          },
          "tenant_context": {
            "$ref": "#/components/schemas/EntityTenantContext"
          }
        },
        "required": [
          "extraction_id",
          "extraction_version",
          "document_id",
          "document_version",
          "tenant_context",
          "amount",
          "invoice_date",
          "expected_transaction_direction",
          "evidence_complete",
          "content_fingerprint"
        ],
        "title": "InvoiceFact",
        "type": "object"
      },
      "MatchConflict": {
